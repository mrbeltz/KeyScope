# Required. A TMDB v3 API key (32 hex chars) or a v4 "API Read Access Token" (starts with eyJ).
VITE_TMDB_API_KEY=

# Optional (v2): draw the puzzle pool from your own Plex library instead of src/data/movies.json.
# VITE_PLEX_URL=https://192-168-1-20.abc123.plex.direct:32400
# VITE_PLEX_TOKEN=
# VITE_PLEX_SECTION=   # library section key; leave blank to use every movie library
