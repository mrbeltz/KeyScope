<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher masks an adaptive icon down to roughly the middle two thirds of its 108dp canvas,
  so the artwork is inset to sit inside that safe circle. Without this the outer ring of note
  names would be sliced off on every launcher that uses a circular mask.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ic_keybro"
        android:left="19dp"
        android:top="19dp"
        android:right="19dp"
        android:bottom="19dp" />
</layer-list>
